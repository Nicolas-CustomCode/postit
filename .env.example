# .env.example — nomes de todas as variáveis. Valores nunca entram no repositório.
#
# Um .env único na raiz, lido por web, API, worker e Prisma. Cada app valida com
# zod, no boot, só as variáveis de que precisa. Em produção na etapa 1, os mesmos
# nomes vão na aba Environment de cada serviço do Easypanel. Ver docs/10.
#
# Segredos: gere cada um separado — `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Compartilhar segredo entre propósitos é como reusar senha.

# ---------- Geral ----------
NODE_ENV=development
# No computador local, o endereço do túnel do app (npm run tunnel). Também decide
# o cookie: https usa __Host-sessao; http usa sessao.
APP_URL=http://localhost:3010
WEB_PORT=3010

# ---------- Comunicação Next -> API ----------
INTERNAL_API_URL=http://127.0.0.1:3011
INTERNAL_API_KEY=

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=3011

# ---------- Sessão ----------
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
TOTP_ISSUER=PostIt

# ---------- Login: prazos e limites ----------
# Valores decididos nos ADRs 0013 e 0015. São os padrões do código: deixar em
# branco ou tirar a linha não muda nada. Mexer aqui é ajuste de operação; baixar
# demais os limites de bloqueio derruba o login de gente legítima.
# O desafio é a etapa entre a senha certa e o código de 6 dígitos.
CHALLENGE_TTL_MINUTES=5
CHALLENGE_MAX_ATTEMPTS=5
# Bloqueio por tentativas: conta (chave é o e-mail) e IP, contados na mesma janela.
LOCKOUT_WINDOW_MINUTES=30
LOCKOUT_ACCOUNT_ATTEMPTS=10
LOCKOUT_ACCOUNT_MINUTES=15
LOCKOUT_IP_ATTEMPTS=20
LOCKOUT_IP_MINUTES=30
# Reincidir dentro da janela de 24 h dobra o tempo do bloqueio.
LOCKOUT_REPEAT_MINUTES=60
LOCKOUT_REPEAT_WINDOW_HOURS=24
# Links gerados pelos comandos admin:*, de uso único.
SIGNUP_LINK_DAYS=7
PASSWORD_RESET_LINK_HOURS=24
# Ação administrativa exige um código digitado há menos que isto.
RECENT_CONFIRMATION_MINUTES=15

# ---------- Banco ----------
# Local: o Postgres do docker-compose.yml, na porta 5435.
DATABASE_URL=postgresql://postit:postit@127.0.0.1:5435/postit
# Banco dos testes da API. Precisa terminar em _test: o teste recusa rodar em outro.
TEST_DATABASE_URL=postgresql://postit:postit@127.0.0.1:5435/postit_test
POSTGRES_USER=postit
POSTGRES_PASSWORD=postit
POSTGRES_DB=postit

# ---------- Armazenamento de mídia ----------
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ROOT_USER=postit
MINIO_ROOT_PASSWORD=postit-local-123
MINIO_BUCKET=postit
# A que a Meta e o navegador acessam. No local, o endereço do segundo túnel.
MINIO_PUBLIC_URL=http://localhost:9002
MINIO_LOCAL_PORT=9002
# ⚠️ Com o túnel ligado, MINIO_PUBLIC_URL precisa ser o endereço do túnel de
# mídia — senão a página, servida por https, não carrega imagem em http, e o
# envio direto não acha o destino. O CORS do MinIO sai do APP_URL e é lido no
# boot: depois de trocar, recrie o container.
#   docker compose up -d --force-recreate minio

# ---------- Instagram — app PostIt Dev no local, PostIt em produção ----------
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3010/contas/conectar/retorno
IG_API_VERSION=v26.0

# Endereços da Meta. Só existem como variável para o teste apontar para a Meta
# falsa: trocar qualquer um deles com NODE_ENV diferente de test IMPEDE a API e o
# worker de subirem (AGENTS.md, regra 23). Deixe como estão.
META_AUTH_URL=https://www.instagram.com
META_TOKEN_URL=https://api.instagram.com
META_GRAPH_URL=https://graph.instagram.com

# ---------- Criptografia ----------
# 32 bytes em hexadecimal. Cifra tokens do Instagram e segredos das duas etapas.
ENCRYPTION_KEY=
# Assinatura HMAC do state do OAuth.
STATE_SECRET=

# ---------- Notificações push ----------
# Par gerado com `npx web-push generate-vapid-keys` — um par por ambiente (docs/11).
# Vazias, o push fica desligado e o sino continua recebendo tudo (ADR 0017).
# A pública vai para o web e o worker; a privada e o subject, só para o worker.
PUSH_SWEEP_SECONDS=10
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
