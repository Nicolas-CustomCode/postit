{
  "name": "@repo/api",
  "version": "0.1.2",
  "private": true,
  "//": "NestJS 11 com Fastify. Um código, dois processos: main.ts (HTTP, só o Next alcança) e worker.ts (filas, sem HTTP). Só o worker publica. Ver docs/05 e docs/adr/0010.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "fake-meta": "node dist/fake-meta/main.js"
  },
  "//scripts": "O dev usa a CLI do Nest, e não tsx: a injeção de dependência depende dos metadados de decorator, que o esbuild não emite. fake-meta sobe a Meta falsa dos testes de tela, e só com NODE_ENV=test.",
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "@repo/database": "*",
    "@repo/shared": "*",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.5",
    "@types/jest": "30.0.0",
    "jest": "30.5.1",
    "ts-jest": "29.4.12"
  }
}
