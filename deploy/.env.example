# deploy/.env.example — as variáveis do compose de produção (ADR 0030). Valores nunca
# entram no repositório.
#
# No Easypanel: aba Environment do serviço Compose, com "Create .env file" ligado.
# Fora dele: um .env ao lado do compose.yml.
#
# Segredos: gere cada um separado —
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Compartilhar segredo entre propósitos é como reusar senha. E nunca copie estes
# valores para o computador de desenvolvimento (AGENTS.md, regra 21).

# ---------- Versão ----------
# A tag publicada pela CI no GHCR. Trocar de versão é mudar isto e fazer Deploy.
POSTIT_TAG=v1.0.0

# ---------- Endereços públicos ----------
# Os dois domínios do Easypanel: app → serviço web:3010, mídia → serviço minio:9000.
APP_URL=https://postit-app.kwlyqm.easypanel.host
MINIO_PUBLIC_URL=https://postit-media.kwlyqm.easypanel.host

# ---------- Banco ----------
POSTGRES_USER=postit
POSTGRES_PASSWORD=
POSTGRES_DB=postit

# ---------- Armazenamento de mídia ----------
MINIO_ROOT_USER=postit
# Mínimo de 8 caracteres, exigência do MinIO.
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=postit

# ---------- Segredos ----------
# 32 bytes em hexadecimal cada. A ENCRYPTION_KEY cifra os tokens do Instagram e os
# segredos das duas etapas: trocá-la depois inutiliza o que já foi gravado.
ENCRYPTION_KEY=
STATE_SECRET=
# Chave entre o web e a api; ao menos 32 caracteres.
INTERNAL_API_KEY=

# ---------- Instagram ----------
# A URI de retorno é montada pelo compose: APP_URL + /contas/conectar/retorno.
# Registre essa URI no painel da Meta.
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v26.0

# ---------- Notificações push ----------
# `npx web-push generate-vapid-keys`, um par só para a produção. Depois de usado, não
# troque: quem ativou o push precisaria ativar de novo. Vazias, o push fica desligado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---------- Opcionais (os padrões são os decididos nos ADRs 0013 e 0015) ----------
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30
# TOTP_ISSUER=PostIt
# PUSH_SWEEP_SECONDS=10
