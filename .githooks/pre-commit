#!/bin/sh
# Sobe a versão patch a cada commit (docs/15). Para pular: SKIP_BUMP=1 git commit ...
[ "$SKIP_BUMP" = "1" ] && exit 0

node scripts/version.mjs patch >/dev/null || exit 1
git add package.json package-lock.json apps/*/package.json packages/*/package.json packages/shared/src/version.ts 2>/dev/null
exit 0
